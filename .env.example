# Do not commit real secrets here.
# Hosted configuration (set these in Render, not in Git):
# QUEUE_CONTEXT_USERNAME=owner
# QUEUE_CONTEXT_PASSWORD=<unique password, at least 20 characters>
# RIOT_API_KEY=<RGAPI-...>
# QUEUE_CONTEXT_PUBLIC_URL=https://your-custom-domain.example
# Render supplies its default public URL automatically.
#
# For local development, export RIOT_API_KEY in your shell before starting QContext.
